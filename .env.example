# ==========================================
# PRODUCT
# ==========================================

NEXT_PUBLIC_PRODUCT_NAME=Developer Tools
NEXT_PUBLIC_PRODUCT_SHORT_NAME=DevTools
NEXT_PUBLIC_PRODUCT_DESCRIPTION=Free tools for developers
NEXT_PUBLIC_PRODUCT_URL=http://localhost:3001
NEXT_PUBLIC_GITHUB_URL=


# ==========================================
# API
# ==========================================

NEXT_PUBLIC_API_URL=http://localhost:5000
API_PORT=5000
WEB_URL=http://localhost:3001

# Allows the API proxy to reach private/loopback/link-local network addresses (e.g. localhost) —
# this is an SSRF guard. The value below (true) is for LOCAL DEVELOPMENT ONLY.
#
# ⚠ PRODUCTION: do not set this variable at all (or set it to false). Leaving it unset lets the
# code's own default take over (false whenever NODE_ENV=production), which is the safe choice —
# copying this file's "true" value verbatim into a production .env would reopen SSRF to your
# hosting provider's internal network and cloud metadata endpoints.
API_PROXY_ALLOW_PRIVATE_NETWORKS=true

# Outbound proxy request timeout, in milliseconds.
API_PROXY_TIMEOUT_MS=15000

# Maximum bytes read from an upstream response before the proxy aborts and reports
# "Response exceeded the maximum allowed size." (10 MB)
API_PROXY_MAX_RESPONSE_SIZE=10485760

# Maximum bytes accepted for an incoming request body to the proxy. Must stay >= ~7 MB to fit a
# base64-encoded 5 MB file upload (see MAX_FORM_FILE_SIZE_BYTES in apps/web/lib/api-client/client.ts
# and MAX_FILE_DATA_LENGTH in apps/api/src/validators/request.validator.ts). (10 MB)
API_PROXY_MAX_REQUEST_SIZE=10485760


# ==========================================
# RESERVED FOR FUTURE FEATURES (not read by any code yet — safe to leave blank)
# ==========================================

# DATABASE — only needed once a tool requires server-side persistence.
DATABASE_URL=

# AUTHENTICATION — only needed once user accounts / saved workspaces ship.
JWT_SECRET=

# AI — only needed once the planned AI/DevPilot layer ships. Every tool today is fully
# deterministic and client-side; nothing in this repo currently calls out to an LLM.
OPENAI_API_KEY=